# /etc/systemd/system/pdf-label.service
[Unit]
Description=pdf-label — recorte de etiquetas pela web
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/pdf-label
Environment=PATH=/srv/pdf-label/.venv/bin
ExecStart=/srv/pdf-label/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 \
          --timeout 60 server:app
Restart=always
RestartSec=3

# Os recortes vivem em /tmp e sao descartaveis; PrivateTmp isola do resto da maquina.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
